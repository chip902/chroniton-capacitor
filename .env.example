# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your_super_secret_key_here_minimum_32_characters_abcdefghijklmnopqrstuvwxyz
TIMEZONE=UTC

# API Settings
API_HOST=0.0.0.0
API_PORT=8008

# CORS Settings (can be comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8008"]

# OAuth Security Settings
OAUTH_STATE_SECRET=your_oauth_state_secret_here_minimum_16_chars
OAUTH_SESSION_TIMEOUT_MINUTES=30

# Google Calendar OAuth Configuration
# Get these from Google Cloud Console (see OAUTH_SETUP.md)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI is auto-generated, but you can override it:
# GOOGLE_REDIRECT_URI=http://localhost:8008/api/auth/google/callback

# Microsoft Graph OAuth Configuration  
# Get these from Azure AD App Registration (see OAUTH_SETUP.md)
MS_CLIENT_ID=your_microsoft_client_id
MS_CLIENT_SECRET=your_microsoft_client_secret
MS_TENANT_ID=common
# MS_REDIRECT_URI is auto-generated, but you can override it:
# MS_REDIRECT_URI=http://localhost:8008/api/auth/microsoft/callback

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password
REDIS_SSL=0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Settings
STORAGE_PATH=/app/storage
UPLOAD_FOLDER=uploads

# Sync Settings
SYNC_INTERVAL_MINUTES=5
SYNC_ENABLED=1

# MCP Settings
MCP_SERVICE_NAME=Calendar Integration Service
MCP_ENABLED=1

# TensorFlow Settings
TF_CPP_MIN_LOG_LEVEL=2